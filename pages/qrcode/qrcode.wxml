<view class="page" wx:if="{{available}}">
  <view class="name serif">{{name || '茶叶档案'}}</view>

  <view class="hairline"></view>

  <view class="qr-area">
    <image wx:if="{{qr.ready}}" class="qr-image" src="{{qr.path}}" mode="widthFix" />
    <view wx:else class="qr-placeholder">{{qr.hint}}</view>
  </view>

  <view class="preview-button" bindtap="onPreviewTap">直接查看档案</view>

  <view class="save {{qr.ready && !savingImage ? '' : 'save-disabled'}}" bindtap="onSaveTap">
    {{savingImage ? '正在保存' : '保存到相册'}}
  </view>
</view>

<view class="page" wx:elif="{{loaded}}">
  <view class="unavailable serif">这份档案尚未生成</view>
  <view class="unavailable-note">{{errorMessage || '请先补齐茶名、茶类、产品简介和档案主视觉，再生成档案。'}}</view>
</view>
