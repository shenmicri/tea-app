.name {
  font-size: 44rpx;
  letter-spacing: 4rpx;
  margin-bottom: 40rpx;
}

.qr-area {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.qr-image {
  width: 440rpx;
}

/* 占位方块，接上云函数后由 image 替换 */
.qr-placeholder {
  width: 440rpx;
  height: 440rpx;
  box-sizing: border-box;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
  background: #f0ece2;
}

.preview-button {
  margin-top: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: var(--paper);
  background: var(--tea);
}

.save {
  margin-top: 80rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 4rpx;
  color: var(--paper);
  background: var(--tea);
}

.save-disabled {
  color: var(--muted);
  background: var(--line);
}
.unavailable {
  margin-top: 80rpx;
  font-size: 42rpx;
  color: var(--ink);
}

.unavailable-note {
  margin-top: 20rpx;
  color: var(--ink-weak);
  font-size: 28rpx;
  line-height: 1.9;
}
