.name {
  font-size: 44rpx;
  letter-spacing: 4rpx;
}

.id {
  margin: 10rpx 0 40rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.qr-area {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.qr-image {
  width: 440rpx;
}

/* 占位方块，接上云函数后由 image 替换 */
.qr-placeholder {
  width: 440rpx;
  height: 440rpx;
  box-sizing: border-box;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
  background: #f0ece2;
}

.tip {
  font-size: 26rpx;
  color: var(--ink-weak);
  line-height: 2;
}

.test-entry {
  margin-top: 48rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid var(--line);
}

.test-title {
  font-size: 28rpx;
  color: var(--ink);
}

.test-link {
  display: block;
  margin-top: 16rpx;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
  background: #f0ece2;
}

.test-actions {
  display: flex;
  margin-top: 24rpx;
}

.test-button {
  flex: 1;
  padding: 20rpx 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--tea);
  border: 1rpx solid var(--tea);
}

.test-button + .test-button {
  margin-left: 20rpx;
}

.test-button.primary {
  color: var(--paper);
  background: var(--tea);
}

.test-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.7;
}

.save {
  margin-top: 80rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.save-disabled {
  color: var(--muted);
  background: var(--line);
}
.unavailable {
  margin-top: 80rpx;
  font-size: 42rpx;
  color: var(--ink);
}

.unavailable-note {
  margin-top: 20rpx;
  color: var(--ink-weak);
  font-size: 28rpx;
  line-height: 1.9;
}
