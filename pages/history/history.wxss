.page-selecting {
  padding-bottom: 180rpx;
}

.history-head {
  padding-bottom: 36rpx;
}

.history-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.history-title {
  font-size: 44rpx;
  letter-spacing: 4rpx;
}

.history-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.history-select-action {
  flex: none;
  margin-top: 6rpx;
  padding: 8rpx 0 8rpx 32rpx;
  font-size: 27rpx;
  color: var(--tea);
}

.history-select-action-active {
  opacity: 0.6;
}

.history-row {
  display: flex;
  align-items: center;
  min-height: 176rpx;
  padding: 30rpx 4rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--line);
}

.history-row-active {
  opacity: 0.68;
}

.history-main {
  flex: 1;
  min-width: 0;
}

.select-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 38rpx;
  height: 38rpx;
  margin-right: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #a9a79f;
  border-radius: 50%;
}

.select-circle-checked {
  border-color: var(--tea);
  background: var(--tea);
}

.select-check {
  font-size: 24rpx;
  line-height: 1;
  color: var(--paper);
}

.history-name {
  overflow: hidden;
  font-size: 34rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-category {
  margin-top: 4rpx;
  font-size: 25rpx;
  color: var(--ink-weak);
}

.history-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.history-arrow {
  flex: none;
  margin-left: 24rpx;
  font-size: 46rpx;
  color: var(--tea);
}

.history-empty {
  padding: 120rpx 0;
  font-size: 28rpx;
  line-height: 2;
  color: var(--muted);
}

.history-retry {
  margin-top: 20rpx;
  color: var(--tea);
}

.history-confirm {
  position: fixed;
  right: 40rpx;
  bottom: 64rpx;
  min-width: 190rpx;
  height: 82rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  line-height: 82rpx;
  text-align: center;
  font-size: 27rpx;
  letter-spacing: 2rpx;
  color: var(--paper);
  background: var(--tea);
}

.history-confirm-disabled {
  color: #f4f0e8;
  background: #c8c3b8;
}
