.head {
  padding-bottom: 36rpx;
}

.head-title {
  font-size: 44rpx;
  letter-spacing: 4rpx;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-name {
  font-size: 34rpx;
}

.row-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-weak);
}

.status {
  margin-right: 14rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.status-published {
  color: var(--paper);
  background: var(--tea);
}

.status-draft {
  color: var(--ink-weak);
  background: #ece5d7;
}

.dot {
  margin: 0 12rpx;
  color: var(--muted);
}

.row-actions {
  flex: none;
  margin-left: 32rpx;
  padding-left: 32rpx;
  border-left: 1rpx solid var(--line);
}

.row-action {
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--tea);
}

.row-action + .row-action {
  margin-top: 8rpx;
}

.row-action-disabled {
  color: var(--muted);
}

.empty {
  padding: 120rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 2;
}

.retry {
  margin-top: 20rpx;
  color: var(--tea);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 72rpx;
  width: 180rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--paper);
  background: var(--tea);
}
