.section {
  border-top: 1rpx solid var(--line);
}

.section:first-child {
  border-top: none;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 40rpx 0 12rpx;
}

.section-toggle {
  font-size: 24rpx;
  color: var(--muted);
}

.section-body {
  padding-bottom: 40rpx;
}

.field {
  padding: 28rpx 0;
}

.label {
  font-size: 26rpx;
  color: var(--ink-weak);
  margin-bottom: 12rpx;
}

.req {
  color: var(--tea);
  font-size: 24rpx;
}

.input {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 96rpx;
  color: var(--ink);
  padding: 0 2rpx;
  display: block;
  border-bottom: 1rpx solid var(--line);
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--ink);
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.textarea {
  min-height: 320rpx;
  line-height: 1.8;
}

.picker-empty {
  color: var(--muted);
}

.placeholder {
  color: var(--muted);
}

.cover-hint {
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--ink-weak);
  line-height: 1.8;
}

.cover-item {
  padding-top: 8rpx;
}

.cover-preview {
  width: 100%;
  display: block;
}

.media-editor {
  padding-top: 8rpx;
}

.media-item {
  margin-bottom: 20rpx;
}

/* 图片不加圆角、不加边框 */
.media-preview,
.media-video {
  width: 100%;
  display: block;
}

.media-video {
  height: 360rpx;
}

.image-del {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.image-add {
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--tea);
  border-bottom: 1rpx solid var(--line);
}

.media-hint {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.custom {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.custom-head {
  display: flex;
  align-items: center;
}

.custom-title {
  flex: 1;
}

.custom-del {
  flex: none;
  width: 96rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--muted);
}

.custom-add {
  padding: 32rpx 0;
  font-size: 26rpx;
  color: var(--tea);
}

.custom-add-disabled {
  color: var(--muted);
}

.bottom-space {
  height: 180rpx;
}

.save-bar {
  position: fixed;
  z-index: 9999;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: auto;
  background: var(--paper);
  border-top: 1rpx solid var(--line);
  padding: 20rpx 40rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.save-actions {
  display: flex;
}

.save {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 4rpx;
}

.save-draft {
  color: var(--tea);
  background: var(--paper);
  border: 1rpx solid var(--tea);
  box-sizing: border-box;
}

.save-generate {
  margin-left: 16rpx;
  color: var(--paper);
  background: var(--tea);
}

.save-disabled {
  color: var(--muted);
  background: var(--line);
}
.draft-note {
  margin: 8rpx 0 28rpx;
  padding: 20rpx 24rpx;
  border-left: 4rpx solid var(--gold);
  color: var(--ink-weak);
  font-size: 24rpx;
  line-height: 1.7;
  background: #f5f0e6;
}
