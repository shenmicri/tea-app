<view class="page">


  <!-- 四个固定区块，顺序与内容全部来自 config/schema.js -->
  <view class="section" wx:for="{{SECTIONS}}" wx:for-item="sec" wx:key="key">
    <view class="section-head" bindtap="onToggleSection" data-key="{{sec.key}}">
      <text class="section-title">{{sec.title}}</text>
      <text class="section-toggle">{{collapsed[sec.key] ? '展开' : '收起'}}</text>
    </view>

    <view class="section-body" wx:if="{{!collapsed[sec.key]}}">
      <view id="field-{{sec.key}}-{{f.key}}" class="field" wx:for="{{sec.fields}}" wx:for-item="f" wx:key="key">
        <view class="label">
          {{f.label}}<text class="req" wx:if="{{f.required}}">（必填）</text>
        </view>

        <view wx:if="{{f.type === 'cover'}}" class="cover-editor">
          <view wx:if="{{sections[sec.key][f.key]}}" class="cover-item">
            <image class="cover-preview" src="{{sections[sec.key][f.key]}}" mode="widthFix" />
            <view
              class="image-del"
              data-section="{{sec.key}}"
              data-field="{{f.key}}"
              bindtap="onCoverDelete"
            >删除主视觉</view>
          </view>
          <view
            wx:else
            class="image-add"
            data-section="{{sec.key}}"
            data-field="{{f.key}}"
            bindtap="onCoverAdd"
          >添加主视觉图片</view>
        </view>

        <input
          wx:elif="{{f.type === 'text'}}"
          class="input"
          value="{{sections[sec.key][f.key]}}"
          data-section="{{sec.key}}"
          data-field="{{f.key}}"
          data-focus-id="field-{{sec.key}}-{{f.key}}"
          bindinput="onFieldInput"
          bindfocus="onEditorFocus"
          bindkeyboardheightchange="onEditorKeyboardHeightChange"
          adjust-position="{{true}}"
          cursor-spacing="120"
        />

        <textarea
          wx:elif="{{f.type === 'textarea'}}"
          class="textarea"
          value="{{sections[sec.key][f.key]}}"
          data-section="{{sec.key}}"
          data-field="{{f.key}}"
          data-focus-id="field-{{sec.key}}-{{f.key}}"
          bindinput="onFieldInput"
          bindfocus="onEditorFocus"
          bindkeyboardheightchange="onEditorKeyboardHeightChange"
          adjust-position="{{true}}"
          cursor-spacing="120"
          maxlength="-1"
        />

        <picker
          wx:elif="{{f.type === 'picker'}}"
          range="{{f.options}}"
          data-section="{{sec.key}}"
          data-field="{{f.key}}"
          bindchange="onPickerChange"
        >
          <view class="input picker {{sections[sec.key][f.key] ? '' : 'picker-empty'}}">
            {{sections[sec.key][f.key] || '选择'}}
          </view>
        </picker>

        <view wx:elif="{{f.type === 'media'}}" class="media-editor">
          <view
            class="media-item"
            wx:for="{{sections[sec.key][f.key]}}"
            wx:for-item="media"
            wx:for-index="mediaIndex"
            wx:key="id"
          >
            <image wx:if="{{media.type === 'image'}}" class="media-preview" src="{{media.path}}" mode="widthFix" />
            <video
              wx:else
              class="media-video"
              src="{{media.path}}"
              poster="{{media.poster}}"
              controls
              object-fit="cover"
            />
            <view
              class="image-del"
              data-section="{{sec.key}}"
              data-field="{{f.key}}"
              data-index="{{mediaIndex}}"
              bindtap="onMediaDelete"
            >删除</view>
          </view>
          <view class="image-add" data-section="{{sec.key}}" data-field="{{f.key}}" bindtap="onMediaAdd">
            添加图片或视频
          </view>
          <view class="media-hint">点击后可选择图片或视频；支持添加多项内容。</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 自定义项目共同属于一个不展示名称的逻辑大分类；消费者页只显示各项目本身。 -->
  <view class="section">
    <view class="section-head">
      <text class="section-title">自定义项目</text>
      <text class="section-toggle">{{customSections.length}} / 20</text>
    </view>

    <view class="section-body">
      <view id="custom-field-{{index}}" class="custom" wx:for="{{customSections}}" wx:key="id">
        <view class="custom-head">
          <input
            class="input custom-title"
            placeholder="项目标题"
            placeholder-class="placeholder"
            value="{{item.title}}"
            data-index="{{index}}"
            data-focus-id="custom-field-{{index}}"
            bindinput="onCustomTitleInput"
            bindfocus="onEditorFocus"
            bindkeyboardheightchange="onEditorKeyboardHeightChange"
            adjust-position="{{true}}"
            cursor-spacing="120"
          />
          <view class="custom-del" data-index="{{index}}" bindtap="onCustomRemove">删除</view>
        </view>
        <textarea
          class="textarea"
          value="{{item.content}}"
          data-index="{{index}}"
          data-focus-id="custom-field-{{index}}"
          bindinput="onCustomContentInput"
          bindfocus="onEditorFocus"
          bindkeyboardheightchange="onEditorKeyboardHeightChange"
          adjust-position="{{true}}"
          cursor-spacing="120"
          maxlength="-1"
        />
      </view>

      <view class="custom-add {{customSections.length >= 20 ? 'custom-add-disabled' : ''}}" bindtap="onCustomAdd">
        {{customSections.length >= 20 ? '已达到20个项目上限' : '添加新项目'}}
      </view>
    </view>
  </view>

  <view class="bottom-space" style="height: calc(180rpx + {{editorKeyboardHeight}}px);"></view>
</view>

<!-- cover-view 保证操作区域位于 input / textarea 等原生输入组件之上；catchtap 阻止触摸穿透。 -->
<cover-view class="save-bar" catchtap="onSaveBarTap">
  <cover-view class="save-actions">
    <cover-view class="save save-draft {{initializing || !uploadToken ? 'save-disabled' : ''}}" catchtap="onSaveDraft">{{initializing ? '正在准备' : !uploadToken ? '云端未连接' : saving ? '正在保存' : '保存草稿'}}</cover-view>
    <cover-view class="save save-generate {{canGenerate && !saving && uploadToken ? '' : 'save-disabled'}}" catchtap="onGenerate">生成档案</cover-view>
  </cover-view>
</cover-view>
